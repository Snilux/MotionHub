---
interface Props {
    text: string;
    // Sin href se renderiza un <button> (útil para formularios)
    href?: string;
    type?: "button" | "submit";
    theme: "white" | "dark";
    class?: string;
}

const themeButton = {
    white: "bg-white text-black hover:bg-black hover:text-white border border-black",
    dark: "bg-black text-white hover:bg-white hover:text-black hover:border hover:border-black",
};

const { text, href, type = "button", theme, class: className = "" } = Astro.props;

const classes = `${themeButton[theme]} ${className} text-sm font-regular text-center px-4 py-2 rounded-lg
        transition-colors duration-300 ease-in-out`;
---

<div class="flex items-center justify-center">
    {
        href ? (
            <a href={href} class={classes}>
                {text}
            </a>
        ) : (
            <button
                type={type}
                class={`${classes} cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed`}
            >
                {text}
            </button>
        )
    }
</div>
