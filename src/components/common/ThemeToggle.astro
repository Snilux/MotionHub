---
// Botón para alternar entre modo claro y oscuro (puede haber varios en la página)
interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;
---

<button
    type="button"
    aria-label="Cambiar tema claro/oscuro"
    class={`theme-toggle flex items-center justify-center w-9 h-9 rounded-full text-gray-700 hover:text-gray-900 hover:bg-gray-100 transition-colors ${className}`}
>
    <!-- Luna: visible en modo claro -->
    <svg class="w-5 h-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
    <!-- Sol: visible en modo oscuro -->
    <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
</button>

<script>
    document.querySelectorAll(".theme-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
            const dark = document.documentElement.classList.toggle("dark");
            try {
                localStorage.setItem("theme", dark ? "dark" : "light");
            } catch {}
        });
    });
</script>
