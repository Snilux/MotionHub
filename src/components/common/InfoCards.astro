---
import Icons from "./Icons.astro";

interface Props {
    icon: string;
    text: string;
    description: string;
}
const { icon, text, description } = Astro.props;
---

<!-- Fondo + borde para que la card se distinga del fondo en ambos modos -->
<div class="shadow-lg p-4 rounded-lg bg-white border border-gray-200 dark:bg-gray-100 dark:border-gray-300">
    <div class="flex justify-start items-center gap-2">
        <Icons name={icon} />
        <h3 class="text-lg font-light opacity-80">{text}</h3>
    </div>
    {description && <p class="text-sm opacity-60 pt-2">{description}</p>}
</div>
