---
// Página de perfil compartida por médico y paciente (solo diseño: no guarda cambios).
// El slot por defecto recibe filas <SettingsRow> propias de cada rol,
// que se muestran después de "Datos personales".
import PageHeader from "./PageHeader.astro";
import SettingsRow from "./SettingsRow.astro";
import { card, btnPrimary, btnSecondary, input, label, fechaLarga } from "./styles";

interface Props {
  usuario: {
    nombre: string;
    apellido: string;
    email: string;
    telefono?: string;
    fechaNacimiento?: Date;
    createdAt: Date;
  };
  prefijo?: string;
  subtitulo: string;
  // Datos destacados en la tarjeta negra (cédula, fisioterapeuta, etc.)
  identidad: { label: string; value: string }[];
  fotoDesc: string;
}

const { usuario, prefijo = "", subtitulo, identidad, fotoDesc } = Astro.props;

const iniciales = `${usuario.nombre.charAt(0)}${usuario.apellido.charAt(0)}`.toUpperCase();

const datosPersonales = [
  { id: "perfilNombre",   label: "Nombre",             type: "text",  value: usuario.nombre },
  { id: "perfilApellido", label: "Apellido",           type: "text",  value: usuario.apellido },
  { id: "perfilEmail",    label: "Correo electrónico", type: "email", value: usuario.email, full: true },
  { id: "perfilTelefono", label: "Teléfono",           type: "tel",   value: usuario.telefono ?? "", placeholder: "+52 000 000 0000" },
  {
    id: "perfilNacimiento", label: "Fecha de nacimiento", type: "date",
    value: usuario.fechaNacimiento ? new Date(usuario.fechaNacimiento).toISOString().slice(0, 10) : "",
  },
];

const camposPassword = [
  { id: "passActual",    label: "Contraseña actual", full: true },
  { id: "passNueva",     label: "Nueva contraseña" },
  { id: "passConfirmar", label: "Confirmar nueva contraseña" },
];

const requisitos = [
  "Al menos 8 caracteres",
  "Una letra mayúscula y una minúscula",
  "Al menos un número",
];
---

<div class="max-w-6xl px-6 sm:px-10 py-10 lg:py-14 space-y-12">

  <PageHeader eyebrow="Cuenta">
    <Fragment slot="title"><strong>Mi perfil</strong></Fragment>
    Consulta y actualiza tu información personal y la seguridad de tu cuenta.
  </PageHeader>

  <!-- Tarjeta de identidad -->
  <section class="bg-black text-white rounded-2xl p-8 flex flex-col sm:flex-row sm:items-center gap-6">
    <div class="w-20 h-20 rounded-full bg-white text-black flex items-center justify-center text-3xl font-baloo font-bold shrink-0">
      {iniciales}
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-3xl font-baloo tracking-wide truncate">
        {prefijo}<strong>{usuario.nombre} {usuario.apellido}</strong>
      </p>
      <p class="text-lg text-white/70 mt-1">{subtitulo}</p>
    </div>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-2 sm:text-right">
      {[...identidad, { label: "Miembro desde", value: fechaLarga(new Date(usuario.createdAt)) }].map(({ label: l, value }) => (
        <div>
          <dt class="text-sm text-white/60 font-medium tracking-widest uppercase">{l}</dt>
          <dd class="text-lg font-medium mt-0.5">{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <SettingsRow title="Foto de perfil" desc={fotoDesc}>
    <div class={`${card} flex flex-col sm:flex-row sm:items-center gap-6`}>
      <div class="w-28 h-28 rounded-full bg-black text-white flex items-center justify-center text-4xl font-baloo font-bold shrink-0">
        {iniciales}
      </div>
      <div class="space-y-4">
        <div class="flex flex-wrap gap-3">
          <button type="button" class={btnPrimary}>Cambiar foto</button>
          <button type="button" class={btnSecondary}>Eliminar</button>
        </div>
        <p class="text-base text-gray-600">JPG o PNG, máximo 2 MB.</p>
      </div>
    </div>
  </SettingsRow>

  <SettingsRow title="Datos personales" desc="Información básica de contacto de tu cuenta.">
    <form class={`${card} space-y-6`} onsubmit="return false">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {datosPersonales.map((campo) => (
          <div class={campo.full ? "sm:col-span-2" : ""}>
            <label for={campo.id} class={`${label} block mb-2`}>{campo.label}</label>
            <input id={campo.id} type={campo.type} value={campo.value} placeholder={campo.placeholder} class={input} />
          </div>
        ))}
      </div>
      <div class="flex justify-end border-t border-stone-200 pt-6">
        <button type="button" class={btnPrimary}>Guardar cambios</button>
      </div>
    </form>
  </SettingsRow>

  <slot />

  <SettingsRow title="Contraseña" desc="Usa una contraseña segura que no utilices en otros sitios.">
    <form class={`${card} space-y-6`} onsubmit="return false">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {camposPassword.map((campo) => (
          <div class={campo.full ? "sm:col-span-2" : ""}>
            <label for={campo.id} class={`${label} block mb-2`}>{campo.label}</label>
            <input id={campo.id} type="password" placeholder="••••••••" autocomplete="off" class={input} />
          </div>
        ))}
      </div>

      <ul class="space-y-2">
        {requisitos.map((r) => (
          <li class="flex items-center gap-3 text-base text-gray-700">
            <span class="w-2 h-2 rounded-full bg-stone-400 shrink-0" />
            {r}
          </li>
        ))}
      </ul>

      <div class="flex justify-end border-t border-stone-200 pt-6">
        <button type="button" class={btnPrimary}>Actualizar contraseña</button>
      </div>
    </form>
  </SettingsRow>

</div>
