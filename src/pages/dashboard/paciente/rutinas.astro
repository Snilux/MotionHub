---
import DashboardLayout from "../../../components/common/DashboardLayout.astro";
import PageHeader from "../../../components/dashboard/PageHeader.astro";
import SectionHeader from "../../../components/dashboard/SectionHeader.astro";
import EmptyState from "../../../components/dashboard/EmptyState.astro";
import SearchInput from "../../../components/dashboard/SearchInput.astro";
import { card, btnPrimary, btnSecondary, chip, label, plural, diaRelativo, hora } from "../../../components/dashboard/styles";
import { getSessionFromRequest } from "../../../lib/session";
import mongoose from "mongoose";
import connectDB from "../../../lib/db";
import { Rutina } from "../../../models/Rutina";
import { Progreso } from "../../../models/Progreso";
import { urlArchivo } from "../../../lib/storage";

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== "paciente") return Astro.redirect("/login");

await connectDB();

const [rutinas, ultimas] = await Promise.all([
  Rutina.find({ paciente: session.userId })
    .populate("medico", "nombre apellido especialidad")
    .sort({ activa: -1, createdAt: -1 }),
  // Última sesión registrada de cada rutina
  Progreso.aggregate([
    { $match: { paciente: new mongoose.Types.ObjectId(session.userId) } },
    { $sort: { fecha: -1 } },
    { $group: { _id: "$rutina", fecha: { $first: "$fecha" }, total: { $sum: 1 } } },
  ]),
]);
const ultimaSesion = new Map(ultimas.map((u: any) => [String(u._id), u]));

const grupos = [
  { titulo: "Activas", items: rutinas.filter((r: any) => r.activa) },
  { titulo: "Pausadas", items: rutinas.filter((r: any) => !r.activa) },
].filter((g) => g.items.length > 0);

const activas = rutinas.filter((r: any) => r.activa).length;
const fieldLabel = "text-sm text-gray-600 font-medium uppercase tracking-wide";
---

<DashboardLayout title="Mis Rutinas" role="paciente" nombre={session.nombre} activeSection="/dashboard/paciente/rutinas">

  <div class="max-w-6xl px-6 sm:px-10 py-10 lg:py-14 space-y-12">

    <PageHeader eyebrow="Programas">
      <Fragment slot="title"><strong>Mis Rutinas</strong></Fragment>
      Tienes <strong>{plural(activas, "rutina activa", "rutinas activas")}</strong>.
      Abre una para ver sus ejercicios y registra tu sesión al terminar.
    </PageHeader>

    {rutinas.length > 0 && <SearchInput placeholder="Buscar rutina o ejercicio..." />}

    {grupos.length === 0 ? (
      <>
        <hr class="border-stone-300" />
        <EmptyState title="Aún no tienes rutinas asignadas" text="Tu fisioterapeuta te asignará un programa personalizado." />
      </>
    ) : (
      grupos.map(({ titulo, items }) => (
        <div data-buscar-grupo class="space-y-12">
          <hr class="border-stone-300" />
          <section>
            <SectionHeader title={`${titulo} · ${items.length}`} />
            <div class="space-y-6">
              {items.map((r: any) => {
                const ultima: any = ultimaSesion.get(String(r._id));
                return (
                  <article
                    data-buscar={`${r.nombre} ${r.objetivo ?? ""} ${r.ejercicios.map((e: any) => e.nombre).join(" ")}`}
                    class={`${card} space-y-6 ${r.activa ? "" : "opacity-70"}`}
                  >

                    <!-- Cabecera -->
                    <div class="flex items-start justify-between gap-4">
                      <div class="min-w-0">
                        <h2 class="text-2xl font-semibold text-gray-900">{r.nombre}</h2>
                        {r.objetivo && <p class="text-lg text-gray-600 mt-1">{r.objetivo}</p>}
                      </div>
                      <span class={`${chip(r.activa)} shrink-0`}>{r.activa ? "Activa" : "Pausada"}</span>
                    </div>

                    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-stone-200 pt-5">
                      <div class="col-span-2 sm:col-span-1">
                        <dt class={label}>Fisioterapeuta</dt>
                        <dd class="text-lg font-medium text-gray-900 mt-1">
                          {r.medico ? `Dr. ${r.medico.nombre} ${r.medico.apellido}` : "—"}
                        </dd>
                      </div>
                      <div>
                        <dt class={label}>Frecuencia</dt>
                        <dd class="text-lg font-medium text-gray-900 mt-1">{r.frecuencia || "—"}</dd>
                      </div>
                      <div>
                        <dt class={label}>Ejercicios</dt>
                        <dd class="text-lg font-medium text-gray-900 mt-1">{r.ejercicios.length}</dd>
                      </div>
                      <div class="col-span-2 sm:col-span-1">
                        <dt class={label}>Última sesión</dt>
                        <dd class="text-lg font-medium text-gray-900 mt-1">
                          {ultima ? `${diaRelativo(new Date(ultima.fecha))}, ${hora(new Date(ultima.fecha))}` : "Ninguna aún"}
                        </dd>
                      </div>
                    </dl>

                    {!r.activa && (
                      <p class="text-base text-gray-600">Tu fisioterapeuta pausó esta rutina. No necesitas hacerla por ahora.</p>
                    )}

                    <!-- Ejercicios (acordeón) -->
                    <details class="group">
                      <summary class={`${btnSecondary} inline-flex items-center gap-2 cursor-pointer list-none`}>
                        <span class="text-sm transition-transform group-open:rotate-90">▶</span>
                        Ver ejercicios
                      </summary>

                      <div class="mt-6 space-y-4">
                        {r.ejercicios.map((ej: any, i: number) => (
                          <div class="bg-white border border-stone-200 rounded-xl p-5">
                            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                              <div class="min-w-0">
                                <p class={label}>Ejercicio {i + 1}</p>
                                <p class="text-xl font-semibold text-gray-900 mt-1">{ej.nombre}</p>
                                {ej.descripcion && <p class="text-base text-gray-700 mt-2">{ej.descripcion}</p>}
                                {ej.notas && <p class="text-base text-gray-500 italic mt-1">{ej.notas}</p>}
                              </div>
                              <div class="flex flex-col gap-2 shrink-0">
                                <div class="flex gap-2">
                                  {[
                                    { val: ej.series,       lbl: "series" },
                                    { val: ej.repeticiones, lbl: "reps" },
                                    { val: ej.descanso ?? 30, lbl: "seg" },
                                  ].map(({ val, lbl }) => (
                                    <div class="border border-stone-300 rounded-xl px-3 py-2 text-center min-w-16">
                                      <p class="text-2xl font-baloo font-bold leading-tight">{val}</p>
                                      <p class="text-sm text-gray-600">{lbl}</p>
                                    </div>
                                  ))}
                                </div>

                                <!-- Video subido por el fisioterapeuta: se abre en un modal -->
                                {ej.video && (
                                  <button
                                    type="button"
                                    data-ver-video={urlArchivo(ej.video)}
                                    data-titulo={ej.nombre}
                                    class={`${btnSecondary} w-full inline-flex items-center justify-center gap-2`}
                                  >
                                    <span class="text-sm">▶</span>
                                    Ver video
                                  </button>
                                )}

                                <!-- Enlace externo (rutinas antiguas sin video subido) -->
                                {!ej.video && ej.videoUrl && (
                                  <a
                                    href={ej.videoUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class={`${btnSecondary} w-full inline-flex items-center justify-center gap-2`}
                                  >
                                    <span class="text-sm">▶</span>
                                    Ver video
                                  </a>
                                )}
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </details>

                    {r.activa && r.ejercicios.length > 0 && (
                      <button
                        data-registrar={String(r._id)}
                        data-nombre={r.nombre}
                        data-total={r.ejercicios.length}
                        class={`${btnPrimary} w-full`}
                      >
                        Registrar sesión completada
                      </button>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        </div>
      ))
    )}
  </div>

  <!-- Modal del video de un ejercicio -->
  <div id="modalVideo" class="hidden fixed inset-0 z-50 bg-black/60 dark:bg-[#000]/80 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg border border-gray-200 shadow-lg p-4 sm:p-6 w-full max-w-3xl max-h-[90vh] overflow-y-auto">
      <div class="flex items-start justify-between gap-4 mb-4">
        <h2 class="font-baloo tracking-wide text-2xl"><strong id="videoTitulo">Video del ejercicio</strong></h2>
        <button type="button" id="cerrarVideo" aria-label="Cerrar video" class="text-xl text-gray-500 hover:text-gray-900 px-1">✕</button>
      </div>
      <video id="videoPlayer" controls playsinline preload="metadata" class="w-full max-h-[70vh] rounded-lg bg-black">
        Tu navegador no puede reproducir este video.
      </video>
      <p id="videoError" class="hidden text-base text-red-600 mt-3">No se pudo cargar el video. Inténtalo de nuevo más tarde.</p>
    </div>
  </div>

  <!-- Modal registrar sesión -->
  <div id="modalSesion" class="hidden fixed inset-0 z-50 bg-black/30 dark:bg-[#000]/60 flex items-center justify-center p-4">
    <form id="formSesion" novalidate class="bg-white rounded-lg border border-gray-200 shadow-lg p-6 w-full max-w-sm max-h-[90vh] overflow-y-auto">
      <h2 class="font-baloo tracking-wide text-2xl mb-1"><strong>Registrar sesión</strong></h2>
      <p id="sesionRutina" class="text-base text-gray-600 mb-5">Anota cómo te sentiste hoy</p>
      <div class="space-y-5">
        <div>
          <label for="sesionHechos" class={`${fieldLabel} block mb-1.5`}>Ejercicios completados</label>
          <select id="sesionHechos" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors"></select>
        </div>
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="dolorAntes" class={fieldLabel}>Dolor antes</label>
            <span id="dolorAntesVal" class="text-xl font-baloo font-bold">5</span>
          </div>
          <input id="dolorAntes" type="range" min="0" max="10" value="5" class="w-full accent-black" />
          <div class="flex justify-between text-sm text-gray-500 mt-1">
            <span>Sin dolor</span><span>Máximo</span>
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="dolorDespues" class={fieldLabel}>Dolor después</label>
            <span id="dolorDespuesVal" class="text-xl font-baloo font-bold">3</span>
          </div>
          <input id="dolorDespues" type="range" min="0" max="10" value="3" class="w-full accent-black" />
          <div class="flex justify-between text-sm text-gray-500 mt-1">
            <span>Sin dolor</span><span>Máximo</span>
          </div>
        </div>
        <div>
          <label for="notasSesion" class={`${fieldLabel} block mb-1.5`}>Notas (opcional)</label>
          <textarea id="notasSesion" rows="2" maxlength="1000" placeholder="¿Cómo te sentiste hoy?"
            class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors resize-none"></textarea>
        </div>
        <p id="sesionError" class="hidden text-base text-red-600"></p>
        <div class="flex gap-2 pt-1">
          <button type="button" data-cerrar
            class="flex-1 px-4 py-2.5 border border-gray-200 rounded-lg text-base font-medium hover:border-gray-400 transition-colors">
            Cancelar
          </button>
          <button type="submit" id="guardarSesion"
            class="flex-1 px-4 py-2.5 bg-black text-white rounded-lg text-base font-medium hover:bg-gray-800 transition-colors disabled:opacity-60">
            Guardar
          </button>
        </div>
      </div>
    </form>
  </div>
</DashboardLayout>

<script>
  import { api, aviso, modal, errorEn, $ } from "../../../scripts/ui";

  // Video de un ejercicio: se carga al abrir el modal y se detiene al cerrarlo
  const player = $<HTMLVideoElement>("videoPlayer");
  const mVideo = modal("modalVideo", () => {
    player.pause();
    player.removeAttribute("src");
    player.load();
    errorEn("videoError");
  });
  $("cerrarVideo").addEventListener("click", mVideo.cerrar);
  player.addEventListener("error", () => player.getAttribute("src") && $("videoError").classList.remove("hidden"));
  document.querySelectorAll<HTMLButtonElement>("[data-ver-video]").forEach((btn) => {
    btn.addEventListener("click", () => {
      $("videoTitulo").textContent = btn.dataset.titulo || "Video del ejercicio";
      $("videoError").classList.add("hidden");
      player.src = btn.dataset.verVideo!;
      mVideo.abrir();
      player.play().catch(() => {}); // si el navegador bloquea la reproducción automática, queda el botón ▶
    });
  });

  const form = $<HTMLFormElement>("formSesion");
  const antes = $("dolorAntes");
  const despues = $("dolorDespues");
  const hechos = $<HTMLSelectElement>("sesionHechos");
  const btnGuardar = $<HTMLButtonElement>("guardarSesion");
  let rutinaActual = "";

  const mostrarValores = () => {
    $("dolorAntesVal").textContent = antes.value;
    $("dolorDespuesVal").textContent = despues.value;
  };
  antes.addEventListener("input", mostrarValores);
  despues.addEventListener("input", mostrarValores);

  const m = modal("modalSesion", () => {
    form.reset();
    mostrarValores();
    errorEn("sesionError");
  });
  form.querySelector("[data-cerrar]")!.addEventListener("click", m.cerrar);

  document.querySelectorAll<HTMLButtonElement>("[data-registrar]").forEach((btn) => {
    btn.addEventListener("click", () => {
      rutinaActual = btn.dataset.registrar!;
      const total = Number(btn.dataset.total) || 0;
      $("sesionRutina").textContent = `${btn.dataset.nombre} · anota cómo te sentiste hoy`;
      hechos.innerHTML = "";
      for (let n = total; n >= 0; n--) {
        hechos.add(new Option(n === total ? `Todos (${total})` : `${n} de ${total}`, String(n)));
      }
      m.abrir();
    });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (btnGuardar.disabled) return; // evita registros dobles
    btnGuardar.disabled = true;
    btnGuardar.textContent = "Guardando...";
    errorEn("sesionError");

    const { ok, data } = await api("/api/paciente/progreso", "POST", {
      rutina: rutinaActual,
      dolorAntes: Number(antes.value),
      dolorDespues: Number(despues.value),
      ejerciciosCompletados: Number(hechos.value),
      notasPaciente: $<HTMLTextAreaElement>("notasSesion").value.trim(),
    });

    if (ok) {
      m.cerrar();
      aviso("¡Sesión registrada! Puedes verla en «Mi progreso».", "exito");
      setTimeout(() => location.reload(), 900);
    } else {
      btnGuardar.disabled = false;
      btnGuardar.textContent = "Guardar";
      errorEn("sesionError", data.error || "No se pudo registrar la sesión");
    }
  });
</script>
