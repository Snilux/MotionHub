---
import DashboardLayout from "../../../components/common/DashboardLayout.astro";
import PageHeader from "../../../components/dashboard/PageHeader.astro";
import SectionHeader from "../../../components/dashboard/SectionHeader.astro";
import EmptyState from "../../../components/dashboard/EmptyState.astro";
import { meses, diasSemana, hora, plural, diaRelativo } from "../../../components/dashboard/styles";
import connectDB from "../../../lib/db";
import { User } from "../../../models/User";
import { Cita } from "../../../models/Cita";
import { getSessionFromRequest } from "../../../lib/session";

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== "medico") return Astro.redirect("/login");

await connectDB();

const hoy = new Date();
const manana = new Date(hoy);
manana.setDate(manana.getDate() + 1);

const [totalPacientes, citasHoy, citasPendientes] = await Promise.all([
  User.countDocuments({ role: "paciente", medicoAsignado: session.userId }),
  Cita.countDocuments({ medico: session.userId, fecha: { $gte: hoy, $lt: manana }, estado: { $ne: "cancelada" } }),
  Cita.countDocuments({ medico: session.userId, estado: "pendiente", fecha: { $gte: hoy } }),
]);

const proximasCitas = await Cita.find({
  medico: session.userId,
  fecha: { $gte: hoy },
  estado: { $in: ["pendiente", "confirmada"] },
})
  .populate("paciente", "nombre apellido")
  .sort({ fecha: 1 })
  .limit(5);

const [siguiente, ...agenda] = proximasCitas as any[];

const atajos = [
  { href: "/dashboard/medico/pacientes",   label: "Agregar paciente", desc: "Asigna un nuevo paciente" },
  { href: "/dashboard/medico/rutinas",     label: "Crear rutina",     desc: "Diseña un programa de ejercicio" },
  { href: "/dashboard/medico/expedientes", label: "Ver expedientes",  desc: "Historial clínico completo" },
];
---

<DashboardLayout title="Dashboard" role="medico" nombre={session.nombre} activeSection="/dashboard/medico">

  <div class="max-w-6xl px-6 sm:px-10 py-10 lg:py-14 space-y-12">

    <PageHeader eyebrow={`${diasSemana[hoy.getDay()]}, ${hoy.getDate()} ${meses[hoy.getMonth()]} ${hoy.getFullYear()}`}>
      <Fragment slot="title">Bienvenido, Dr. <strong>{session.nombre}</strong></Fragment>
      Tienes <strong>{plural(citasHoy, "cita", "citas")}</strong> en las próximas 24 horas,
      <strong>{citasPendientes}</strong> por confirmar y acompañas a
      <strong>{plural(totalPacientes, "paciente", "pacientes")}</strong> en su recuperación.
    </PageHeader>

    <!-- Fila 1: siguiente cita | por confirmar -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-7 flex flex-col">
        <SectionHeader title="Tu siguiente cita" />

        {siguiente ? (
          <a href="/dashboard/medico/citas"
            class="group flex-1 flex flex-col justify-between bg-black text-white rounded-2xl p-8 transition-transform duration-200 hover:-translate-y-0.5">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
              <div>
                <p class="text-base text-white/60 font-light uppercase tracking-widest">{diaRelativo(new Date(siguiente.fecha))}</p>
                <p class="text-6xl font-baloo font-bold leading-none mt-2">{hora(new Date(siguiente.fecha))}</p>
              </div>
              <span class={`self-start sm:self-auto text-sm px-3 py-1 rounded-full font-light capitalize
                ${siguiente.estado === "confirmada" ? "bg-white text-black" : "border border-white/40 text-white/80"}`}>
                {siguiente.estado}
              </span>
            </div>
            <div class="mt-8 pt-6 border-t border-white/15 flex items-center justify-between gap-4">
              <div>
                <p class="text-2xl font-medium">{siguiente.paciente.nombre} {siguiente.paciente.apellido}</p>
                <p class="text-base text-white/60 font-light capitalize mt-1">{siguiente.tipo}</p>
              </div>
              <span class="text-2xl transition-transform duration-200 group-hover:translate-x-1">→</span>
            </div>
          </a>
        ) : (
          <EmptyState title="Sin citas próximas" text="Disfruta de un día tranquilo." />
        )}
      </div>

      <div class="lg:col-span-5 flex flex-col">
        <SectionHeader title="Por confirmar" />

        {citasPendientes > 0 ? (
          <a href="/dashboard/medico/citas"
            class="group flex-1 flex flex-col justify-between border border-black rounded-2xl p-8 bg-stone-50 hover:bg-black hover:text-white transition-colors duration-200">
            <p class="text-6xl font-baloo font-bold leading-none">{citasPendientes}</p>
            <div class="mt-8">
              <p class="text-lg">
                {citasPendientes === 1 ? "cita espera" : "citas esperan"} tu confirmación
              </p>
              <p class="text-base font-light opacity-60 mt-1">Revisar ahora →</p>
            </div>
          </a>
        ) : (
          <EmptyState title="Todo al día" text="No hay citas pendientes de confirmar." />
        )}
      </div>
    </section>

    <hr class="border-stone-300" />

    <!-- Fila 2: después | atajos -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-7">
        <SectionHeader title="Después">
          <a href="/dashboard/medico/citas" class="text-base text-gray-500 hover:text-gray-900 font-light">Ver agenda →</a>
        </SectionHeader>

        {agenda.length > 0 ? (
          <!-- Línea de tiempo -->
          <ol class="relative border-l border-stone-300 ml-2 space-y-6">
            {agenda.map((c: any) => {
              const fecha = new Date(c.fecha);
              return (
                <li class="pl-8 relative">
                  <span class={`absolute -left-[7px] top-2 w-3.5 h-3.5 rounded-full border-2 border-black
                    ${c.estado === "confirmada" ? "bg-black" : "bg-stone-100"}`} />
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <p class="text-lg">
                      <span class="font-baloo font-bold">{hora(fecha)}</span>
                      <span class="text-gray-500 font-light"> · {diaRelativo(fecha)}</span>
                    </p>
                    <span class="text-sm text-gray-500 font-light capitalize">{c.estado}</span>
                  </div>
                  <p class="text-lg font-medium text-gray-900 mt-0.5">{c.paciente.nombre} {c.paciente.apellido}</p>
                  <p class="text-base text-gray-500 font-light capitalize">{c.tipo}</p>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="text-base text-gray-500 font-light">No hay más citas programadas.</p>
        )}
      </div>

      <div class="lg:col-span-5">
        <SectionHeader title="Atajos" />
        <ul class="divide-y divide-stone-300 border-y border-stone-300">
          {atajos.map(({ href, label, desc }, i) => (
            <li>
              <a href={href} class="group flex items-center gap-5 py-5">
                <span class="text-sm font-baloo text-gray-400 w-6">{String(i + 1).padStart(2, "0")}</span>
                <div class="flex-1">
                  <p class="text-lg font-medium group-hover:underline underline-offset-4">{label}</p>
                  <p class="text-base text-gray-500 font-light">{desc}</p>
                </div>
                <span class="text-xl text-gray-400 transition-all duration-200 group-hover:text-black group-hover:translate-x-1">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

  </div>
</DashboardLayout>
