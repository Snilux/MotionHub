---
import DashboardLayout from "../../../components/common/DashboardLayout.astro";
import PageHeader from "../../../components/dashboard/PageHeader.astro";
import SectionHeader from "../../../components/dashboard/SectionHeader.astro";
import EmptyState from "../../../components/dashboard/EmptyState.astro";
import SearchInput from "../../../components/dashboard/SearchInput.astro";
import { card, btnPrimary, btnSecondary, label, plural, fechaLarga } from "../../../components/dashboard/styles";
import { getSessionFromRequest } from "../../../lib/session";
import connectDB from "../../../lib/db";
import { Expediente } from "../../../models/Expediente";
import { User } from "../../../models/User";
import { SolicitudExpediente } from "../../../models/SolicitudExpediente";
import { ETIQUETA_CAMPO, textoCampo } from "../../../lib/expediente";

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== "medico") return Astro.redirect("/login");

await connectDB();

// El expediente pertenece al paciente: se muestran los de todos los pacientes
// asignados a este médico, aunque los haya creado otro fisioterapeuta.
const pacientes = await User.find({ role: "paciente", medicoAsignado: session.userId })
  .select("_id nombre apellido email fechaNacimiento")
  .sort({ nombre: 1 })
  .lean();

const expedientes = await Expediente.find({ paciente: { $in: pacientes.map((p) => p._id) } }).lean();
const expPorPaciente = new Map(expedientes.map((e: any) => [String(e.paciente), e]));

// Sugerencias de los pacientes pendientes de revisión
const pendientes = await SolicitudExpediente.find({ paciente: { $in: pacientes.map((p) => p._id) }, estado: "pendiente" })
  .sort({ createdAt: 1 })
  .lean();
const pendientesPorPaciente = new Map<string, any[]>();
for (const s of pendientes) {
  const k = String(s.paciente);
  pendientesPorPaciente.set(k, [...(pendientesPorPaciente.get(k) ?? []), s]);
}

// Pacientes con expediente primero (más recientes arriba), luego los que no tienen
const lista = pacientes
  .map((p: any) => ({ paciente: p, exp: expPorPaciente.get(String(p._id)) as any }))
  .sort((a, b) => {
    // Primero los que tienen sugerencias por revisar
    const pa = pendientesPorPaciente.has(String(a.paciente._id));
    const pb = pendientesPorPaciente.has(String(b.paciente._id));
    if (pa !== pb) return pa ? -1 : 1;
    if (!!a.exp !== !!b.exp) return a.exp ? -1 : 1;
    if (a.exp && b.exp) return new Date(b.exp.updatedAt).getTime() - new Date(a.exp.updatedAt).getTime();
    return 0;
  });

const pacienteId = Astro.url.searchParams.get("paciente");
const seleccionado = lista.find((x) => String(x.paciente._id) === pacienteId) ?? null;
const exp: any = seleccionado?.exp ?? null;
const pacienteSel: any = seleccionado?.paciente ?? null;

const datosClinicos = exp
  ? [
      { label: "Diagnóstico",        value: exp.diagnostico },
      { label: "Motivo de consulta", value: exp.motivoConsulta },
      { label: "Antecedentes",       value: exp.antecedentes },
      { label: "Alergias",           value: exp.alergias },
      { label: "Medicamentos",       value: exp.medicamentos },
      { label: "Presión arterial",   value: exp.presionArterial },
    ].filter((d) => d.value)
  : [];

const medidas = exp
  ? [
      { label: "Altura", value: exp.altura, unidad: "cm" },
      { label: "Peso",   value: exp.peso,   unidad: "kg" },
    ].filter((m) => m.value)
  : [];

const notas = exp ? [...(exp.evolucion ?? [])].reverse() : [];

const sinExpediente = lista.filter((x) => !x.exp).map((x) => x.paciente);

// Sugerencias del paciente seleccionado: pendientes y las últimas revisadas
const sugerencias = (pacienteSel ? pendientesPorPaciente.get(String(pacienteSel._id)) ?? [] : []).map((s: any) => ({
  id: String(s._id),
  campo: s.campo,
  etiqueta: ETIQUETA_CAMPO[s.campo as keyof typeof ETIQUETA_CAMPO],
  actual: s.campo === "otro" ? "" : textoCampo(exp, s.campo),
  anterior: s.valorAnterior ?? "",
  propuesto: s.valorPropuesto,
  comentario: s.comentario ?? "",
  fecha: fechaLarga(new Date(s.createdAt)),
}));
const revisadas: any[] = exp
  ? await SolicitudExpediente.find({ paciente: pacienteSel._id, estado: { $ne: "pendiente" } })
      .sort({ revisadaEn: -1 })
      .limit(5)
      .lean()
  : [];

// Datos para precargar el formulario de edición
const expDatos = exp
  ? JSON.stringify({
      paciente: String(pacienteSel._id),
      diagnostico: exp.diagnostico ?? "",
      motivoConsulta: exp.motivoConsulta ?? "",
      antecedentes: exp.antecedentes ?? "",
      alergias: exp.alergias ?? "",
      medicamentos: exp.medicamentos ?? "",
      presionArterial: exp.presionArterial ?? "",
      altura: exp.altura ?? "",
      peso: exp.peso ?? "",
    })
  : "";

const camposTexto = [
  { id: "expDiagnostico",   name: "diagnostico",     label: "Diagnóstico *" },
  { id: "expMotivo",        name: "motivoConsulta",  label: "Motivo de consulta *" },
  { id: "expAntecedentes",  name: "antecedentes",    label: "Antecedentes" },
  { id: "expAlergias",      name: "alergias",        label: "Alergias" },
  { id: "expMedicamentos",  name: "medicamentos",    label: "Medicamentos actuales" },
  { id: "expPresion",       name: "presionArterial", label: "Presión arterial", placeholder: "Ej: 120/80" },
];
const fieldCls = "w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors";
const labelCls = "text-sm text-gray-600 font-medium block mb-1.5 uppercase tracking-wide";
---

<DashboardLayout title="Expedientes" role="medico" nombre={session.nombre} activeSection="/dashboard/medico/expedientes">

  <div class="max-w-6xl px-6 sm:px-10 py-10 lg:py-14 space-y-12">

    <PageHeader eyebrow="Clínico">
      <Fragment slot="title"><strong>Expedientes</strong></Fragment>
      Tienes <strong>{plural(expedientes.length, "expediente clínico", "expedientes clínicos")}</strong> a tu cargo
      {sinExpediente.length > 0 && <> y <strong>{plural(sinExpediente.length, "paciente", "pacientes")}</strong> sin expediente</>}.
      {pendientes.length > 0 && <> Hay <strong>{plural(pendientes.length, "sugerencia", "sugerencias")}</strong> de pacientes por revisar.</>}
      <button slot="action" id="nuevoExpBtn" class={`${btnPrimary} shrink-0 self-start sm:self-auto`}>
        + Nuevo expediente
      </button>
    </PageHeader>

    <SearchInput placeholder="Buscar expediente por paciente o diagnóstico..." />

    <hr class="border-stone-300" />

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-10">

      <!-- Lista de pacientes -->
      <div class="lg:col-span-4">
        <SectionHeader title={`Pacientes · ${lista.length}`} />
        {lista.length === 0 ? (
          <EmptyState title="Sin pacientes" text="Asigna pacientes para crear sus expedientes.">
            <a href="/dashboard/medico/pacientes?nuevo=1" class={`${btnPrimary} mt-6`}>Asignar paciente</a>
          </EmptyState>
        ) : (
          <ul class="space-y-3">
            {lista.map(({ paciente: p, exp: e }) => {
              const activo = pacienteId === String(p._id);
              const nPend = pendientesPorPaciente.get(String(p._id))?.length ?? 0;
              return (
                <li data-buscar={`${p.nombre} ${p.apellido} ${p.email} ${e?.diagnostico ?? ""}`}>
                  <a href={`/dashboard/medico/expedientes?paciente=${p._id}`}
                    class={`flex items-center gap-4 rounded-2xl border p-4 transition-colors duration-200
                      ${activo ? "bg-black text-white border-black" : "bg-stone-50 border-stone-200 hover:border-black"}`}>
                    <div class={`w-11 h-11 rounded-full flex items-center justify-center text-lg font-baloo font-bold shrink-0
                      ${activo ? "bg-white text-black" : "bg-black text-white"}`}>
                      {p.nombre.charAt(0).toUpperCase()}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="text-lg font-semibold truncate">{p.nombre} {p.apellido}</p>
                      <p class={`text-base truncate ${activo ? "text-white/70" : e ? "text-gray-600" : "text-gray-400 italic"}`}>
                        {e ? e.diagnostico : "Sin expediente"}
                      </p>
                    </div>
                    {nPend > 0 && (
                      <span title={plural(nPend, "sugerencia por revisar", "sugerencias por revisar")}
                        class={`shrink-0 min-w-7 h-7 px-2 rounded-full text-sm font-bold flex items-center justify-center
                          ${activo ? "bg-white text-black" : "bg-black text-white"}`}>
                        {nPend}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </div>

      <!-- Detalle del expediente -->
      <div class="lg:col-span-8 flex flex-col">
        <SectionHeader title="Expediente" />

        {!pacienteSel ? (
          <EmptyState title="Selecciona un paciente" text="Elige un paciente de la lista para ver su historial clínico." />
        ) : !exp ? (
          <EmptyState title={`${pacienteSel.nombre} ${pacienteSel.apellido} aún no tiene expediente`} text="Registra su historial clínico para darle seguimiento.">
            <button data-crear-para={String(pacienteSel._id)} class={`${btnPrimary} mt-6`}>+ Crear expediente</button>
          </EmptyState>
        ) : (
          <div class="space-y-10" id="detalleExp" data-exp={expDatos}>

            <!-- Paciente -->
            <div class={`${card} flex flex-col sm:flex-row sm:items-center justify-between gap-4`}>
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-14 h-14 rounded-full bg-black flex items-center justify-center text-white text-2xl font-baloo font-bold shrink-0">
                  {pacienteSel.nombre.charAt(0).toUpperCase()}
                </div>
                <div class="min-w-0">
                  <h2 class="text-2xl font-baloo tracking-wide truncate">
                    <strong>{pacienteSel.nombre} {pacienteSel.apellido}</strong>
                  </h2>
                  <p class="text-base text-gray-600 truncate">{pacienteSel.email}</p>
                </div>
              </div>
              <div class="flex flex-col sm:items-end gap-3 shrink-0">
                <p class="text-base text-gray-600">
                  Actualizado el <span class="font-medium text-gray-900">{fechaLarga(new Date(exp.updatedAt))}</span>
                </p>
                <button id="exportarPdfBtn" data-paciente={String(pacienteSel._id)} class={`${btnSecondary} self-start sm:self-auto`}>
                  Exportar PDF
                </button>
              </div>
            </div>

            <!-- Sugerencias del paciente -->
            {sugerencias.length > 0 && (
              <div>
                <SectionHeader title={`Sugerencias del paciente · ${sugerencias.length}`} />
                <ul class="space-y-3">
                  {sugerencias.map((s) => (
                    <li class={`${card} flex flex-col sm:flex-row sm:items-center gap-4`}>
                      <div class="flex-1 min-w-0 space-y-1">
                        <p class={label}>{s.etiqueta} · {s.fecha}</p>
                        {s.campo !== "otro" && (
                          <p class="text-base text-gray-500 break-words">Actual: <span class="text-gray-700">{s.actual || "Sin registrar"}</span></p>
                        )}
                        <p class="text-lg font-medium text-gray-900 whitespace-pre-line break-words">
                          {s.campo !== "otro" && <span class="text-base font-normal text-gray-500">Propuesto: </span>}{s.propuesto}
                        </p>
                        {s.comentario && <p class="text-base text-gray-600 italic break-words">“{s.comentario}”</p>}
                      </div>
                      <button data-revisar={JSON.stringify(s)} class={`${btnPrimary} shrink-0 self-start sm:self-auto`}>Revisar</button>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Datos clínicos y medidas -->
            <div>
              <SectionHeader title="Datos clínicos">
                <button id="editarExpBtn" class={btnSecondary}>Editar</button>
              </SectionHeader>
              <dl class={`${card} grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6`}>
                {datosClinicos.map(({ label: l, value }) => (
                  <div>
                    <dt class={label}>{l}</dt>
                    <dd class="text-lg font-medium text-gray-900 mt-1">{value}</dd>
                  </div>
                ))}
                {medidas.map(({ label: l, value, unidad }) => (
                  <div>
                    <dt class={label}>{l}</dt>
                    <dd class="mt-1">
                      <span class="text-3xl font-baloo font-bold">{value}</span>
                      <span class="text-base text-gray-600 ml-1">{unidad}</span>
                    </dd>
                  </div>
                ))}
              </dl>
            </div>

            <!-- Notas de evolución -->
            <div>
              <SectionHeader title="Notas de evolución">
                <button id="agregarNotaBtn" class={btnSecondary}>+ Agregar nota</button>
              </SectionHeader>

              <form id="notaForm" class="hidden mb-6 space-y-3" novalidate>
                <textarea id="notaTexto" rows="3" placeholder="Nota de evolución..."
                  class="w-full px-4 py-3 bg-stone-50 border border-stone-300 rounded-xl text-base focus:outline-none focus:border-black transition-colors resize-none"></textarea>
                <button type="submit" id="guardarNota" data-paciente={String(pacienteSel._id)} class={btnPrimary}>
                  Guardar nota
                </button>
              </form>

              {notas.length === 0 ? (
                <p class="text-base text-gray-600">Sin notas de evolución.</p>
              ) : (
                <ol class="relative border-l border-stone-300 ml-2 space-y-6">
                  {notas.map((nota: any, i: number) => (
                    <li class="pl-8 relative">
                      <span class={`absolute -left-[7px] top-1.5 w-3.5 h-3.5 rounded-full border-2 border-black
                        ${i === 0 ? "bg-black" : "bg-stone-100"}`} />
                      <p class="text-base font-baloo font-bold">{fechaLarga(new Date(nota.fecha))}</p>
                      <p class="text-lg text-gray-900 mt-1 leading-relaxed whitespace-pre-line">{nota.nota}</p>
                    </li>
                  ))}
                </ol>
              )}
            </div>

            <!-- Sugerencias ya revisadas -->
            {revisadas.length > 0 && (
              <div>
                <SectionHeader title="Sugerencias revisadas" />
                <ul class="divide-y divide-stone-300 border-y border-stone-300">
                  {revisadas.map((s: any) => (
                    <li class="py-4 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
                      <p class="sm:w-40 shrink-0 text-base font-baloo font-bold text-gray-700">{fechaLarga(new Date(s.revisadaEn ?? s.updatedAt))}</p>
                      <p class="flex-1 min-w-0 text-base text-gray-900 truncate">
                        <span class="text-gray-500">{ETIQUETA_CAMPO[s.campo as keyof typeof ETIQUETA_CAMPO]}:</span>
                        {" "}{s.estado === "aprobada" ? s.valorAplicado ?? s.valorPropuesto : s.valorPropuesto}
                      </p>
                      <span class={`text-sm px-3 py-1 rounded-full font-medium self-start sm:self-auto ${
                        s.estado === "aprobada" ? "bg-black text-white" : "border border-stone-400 text-gray-600"}`}>
                        {s.estado === "aprobada" ? "Integrada" : "Rechazada"}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
      </div>
    </section>
  </div>

  <!-- Modal nuevo / editar expediente -->
  <div id="modalExp" class="hidden fixed inset-0 z-50 bg-black/30 dark:bg-[#000]/60 flex items-center justify-center p-4">
    <form id="formExp" novalidate class="bg-white rounded-lg border border-gray-200 shadow-lg p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <h2 class="font-baloo tracking-wide text-2xl mb-1"><strong id="expTitulo">Nuevo expediente</strong></h2>
      <p class="text-base text-gray-600 mb-5">Historial clínico del paciente</p>
      <div class="space-y-3">
        <div id="expPacienteWrap">
          <label for="expPaciente" class={labelCls}>Paciente</label>
          <select id="expPaciente" class={fieldCls}>
            <option value="">Seleccionar...</option>
            {sinExpediente.map((p: any) => <option value={String(p._id)}>{p.nombre} {p.apellido}</option>)}
          </select>
          {sinExpediente.length === 0 && (
            <p class="text-sm text-gray-500 mt-1.5">Todos tus pacientes ya tienen expediente.</p>
          )}
        </div>
        {camposTexto.map(({ id, name, label: l, placeholder }) => (
          <div>
            <label for={id} class={labelCls}>{l}</label>
            <input id={id} name={name} type="text" placeholder={placeholder} class={fieldCls} />
          </div>
        ))}
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="expAltura" class={labelCls}>Altura (cm)</label>
            <input id="expAltura" name="altura" type="number" min="30" max="250" class={fieldCls} />
          </div>
          <div>
            <label for="expPeso" class={labelCls}>Peso (kg)</label>
            <input id="expPeso" name="peso" type="number" min="1" max="400" step="0.1" class={fieldCls} />
          </div>
        </div>
        <p id="expError" class="hidden text-base text-red-600"></p>
        <div class="flex gap-2 pt-1">
          <button type="button" id="cancelarExp" class="flex-1 px-4 py-2.5 border border-gray-200 rounded-lg text-base font-medium hover:border-gray-400 transition-colors">Cancelar</button>
          <button type="submit" id="guardarExp" class="flex-1 px-4 py-2.5 bg-black text-white rounded-lg text-base font-medium hover:bg-gray-800 transition-colors disabled:opacity-60">Guardar</button>
        </div>
      </div>
    </form>
  </div>

  <!-- Modal revisar sugerencia del paciente -->
  <div id="modalRev" class="hidden fixed inset-0 z-50 bg-black/30 dark:bg-[#000]/60 flex items-center justify-center p-4">
    <form id="formRev" novalidate class="bg-white rounded-lg border border-gray-200 shadow-lg p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <h2 class="font-baloo tracking-wide text-2xl mb-1"><strong>Revisar sugerencia</strong></h2>
      <p class="text-base text-gray-600 mb-5">
        <span id="revCampo"></span> · Nada cambia en el expediente hasta que lo apruebes.
      </p>
      <div class="space-y-3">
        <div id="revActualWrap">
          <p class={labelCls}>Valor actual en el expediente</p>
          <p id="revActual" class="text-base text-gray-900 bg-stone-50 border border-stone-200 rounded-lg px-3 py-2.5 whitespace-pre-line break-words"></p>
          <p id="revCambio" class="hidden text-sm text-amber-700 mt-1.5">
            El expediente cambió desde que el paciente envió la sugerencia (entonces era: <span id="revAnterior"></span>).
          </p>
        </div>
        <div id="revComentarioWrap">
          <p class={labelCls}>Comentario del paciente</p>
          <p id="revComentario" class="text-base text-gray-700 italic break-words"></p>
        </div>
        <div>
          <label for="revValor" id="revValorLabel" class={labelCls}>Valor a integrar</label>
          <textarea id="revValor" rows="3" maxlength="1000" class={`${fieldCls} resize-none`}></textarea>
          <p class="text-sm text-gray-500 mt-1.5">Es lo que propuso el paciente; puedes ajustarlo antes de aprobar.</p>
        </div>
        <div>
          <label for="revRespuesta" class={labelCls}>Respuesta al paciente (opcional)</label>
          <textarea id="revRespuesta" rows="2" maxlength="500" class={`${fieldCls} resize-none`}></textarea>
        </div>
        <p id="revError" class="hidden text-base text-red-600"></p>
        <div class="flex flex-col sm:flex-row gap-2 pt-1">
          <button type="button" id="cancelarRev" class="sm:flex-1 px-4 py-2.5 border border-gray-200 rounded-lg text-base font-medium hover:border-gray-400 transition-colors">Cerrar</button>
          <button type="button" id="rechazarRev" class="sm:flex-1 px-4 py-2.5 border border-red-300 text-red-700 rounded-lg text-base font-medium hover:bg-red-50 transition-colors disabled:opacity-60">Rechazar</button>
          <button type="submit" id="aprobarRev" class="sm:flex-1 px-4 py-2.5 bg-black text-white rounded-lg text-base font-medium hover:bg-gray-800 transition-colors disabled:opacity-60">Aprobar</button>
        </div>
      </div>
    </form>
  </div>
</DashboardLayout>

<script>
  import { alerta, api, aviso, confirmar, descargar, exito, modal, unaVez, abrirSiNuevo, errorEn, $ } from "../../../scripts/ui";

  // Exportar expediente a PDF
  const btnPdf = document.getElementById("exportarPdfBtn") as HTMLButtonElement | null;
  if (btnPdf) {
    unaVez(btnPdf, async () => {
      const error = await descargar(`/api/medico/expediente-pdf?paciente=${btnPdf.dataset.paciente}`, "expediente.pdf");
      if (error) aviso(error, "error");
      else await alerta({ titulo: "Expediente exportado", mensaje: "El PDF se descargó en tu dispositivo (carpeta de descargas)." });
    }, "Generando...");
  }

  const form = $<HTMLFormElement>("formExp");
  const selPaciente = $<HTMLSelectElement>("expPaciente");
  let editandoPaciente: string | null = null;
  let guardando = false;

  const limpiar = () => {
    form.reset();
    editandoPaciente = null;
    $("expPacienteWrap").classList.remove("hidden");
    errorEn("expError");
  };
  const m = modal("modalExp", limpiar);
  $("cancelarExp").addEventListener("click", m.cerrar);

  const abrirNuevo = (pacienteId?: string | null) => {
    limpiar();
    $("expTitulo").textContent = "Nuevo expediente";
    if (pacienteId) selPaciente.value = pacienteId;
    m.abrir();
  };

  document.getElementById("nuevoExpBtn")?.addEventListener("click", () => abrirNuevo());
  document.querySelectorAll<HTMLElement>("[data-crear-para]").forEach((b) =>
    b.addEventListener("click", () => abrirNuevo(b.dataset.crearPara)),
  );
  abrirSiNuevo(() => abrirNuevo(new URLSearchParams(location.search).get("paciente")));

  // Editar datos clínicos
  document.getElementById("editarExpBtn")?.addEventListener("click", () => {
    const datos = JSON.parse($("detalleExp").dataset.exp || "{}");
    limpiar();
    editandoPaciente = datos.paciente;
    $("expTitulo").textContent = "Editar expediente";
    $("expPacienteWrap").classList.add("hidden");
    form.querySelectorAll<HTMLInputElement>("input[name]").forEach((i) => (i.value = datos[i.name] ?? ""));
    m.abrir();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (guardando) return;

    const datos: Record<string, string> = {};
    form.querySelectorAll<HTMLInputElement>("input[name]").forEach((i) => (datos[i.name] = i.value.trim()));
    const paciente = editandoPaciente ?? selPaciente.value;

    if (!paciente) return errorEn("expError", "Selecciona un paciente.");
    if (!datos.diagnostico || !datos.motivoConsulta) return errorEn("expError", "Diagnóstico y motivo de consulta son requeridos.");

    guardando = true;
    $<HTMLButtonElement>("guardarExp").disabled = true;
    const { ok, data } = editandoPaciente
      ? await api("/api/medico/expediente", "PUT", { pacienteId: paciente, ...datos })
      : await api("/api/medico/expediente", "POST", { paciente, ...datos });
    if (ok) {
      // Sigue bloqueado hasta salir de la página para que no se guarde dos veces
      await exito(
        editandoPaciente ? "Expediente actualizado" : "Expediente creado",
        editandoPaciente ? "Los cambios quedaron guardados en el expediente." : "El expediente del paciente quedó creado.",
        `/dashboard/medico/expedientes?paciente=${paciente}`,
      );
    } else {
      guardando = false;
      $<HTMLButtonElement>("guardarExp").disabled = false;
      errorEn("expError", data.error || "No se pudo guardar");
    }
  });

  // Notas de evolución
  document.getElementById("agregarNotaBtn")?.addEventListener("click", () => {
    const f = $("notaForm");
    f.classList.toggle("hidden");
    if (!f.classList.contains("hidden")) $("notaTexto").focus();
  });
  let guardandoNota = false;
  document.getElementById("notaForm")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const nota = $<HTMLTextAreaElement>("notaTexto").value.trim();
    const pacienteId = $("guardarNota").dataset.paciente;
    if (!nota) return aviso("Escribe la nota antes de guardar", "error");
    if (guardandoNota) return;
    guardandoNota = true;
    $<HTMLButtonElement>("guardarNota").disabled = true;
    const { ok, data } = await api("/api/medico/expediente", "PUT", { pacienteId, notaEvolucion: nota });
    if (ok) {
      await exito("Nota agregada", "La nota de evolución quedó guardada en el expediente.");
    } else {
      guardandoNota = false;
      $<HTMLButtonElement>("guardarNota").disabled = false;
      aviso(data.error || "No se pudo guardar la nota", "error");
    }
  });

  // Revisión de sugerencias del paciente: el médico debe confirmar antes de integrar
  type Sugerencia = { id: string; campo: string; etiqueta: string; actual: string; anterior: string; propuesto: string; comentario: string };
  let sugerencia: Sugerencia | null = null;
  let revisando = false;
  const mRev = modal("modalRev", () => {
    sugerencia = null;
    $<HTMLFormElement>("formRev").reset();
    errorEn("revError");
  });
  $("cancelarRev").addEventListener("click", mRev.cerrar);

  document.querySelectorAll<HTMLElement>("[data-revisar]").forEach((b) =>
    b.addEventListener("click", () => {
      const s: Sugerencia = JSON.parse(b.dataset.revisar!);
      sugerencia = s;
      const otro = s.campo === "otro";
      errorEn("revError");
      $("revCampo").textContent = s.etiqueta;
      $("revActualWrap").classList.toggle("hidden", otro);
      $("revActual").textContent = s.actual || "Sin registrar";
      $("revAnterior").textContent = s.anterior || "sin registrar";
      $("revCambio").classList.toggle("hidden", otro || s.actual === s.anterior);
      $("revComentarioWrap").classList.toggle("hidden", !s.comentario);
      $("revComentario").textContent = s.comentario ? `“${s.comentario}”` : "";
      $("revValorLabel").textContent = otro ? "Nota a integrar en la evolución" : "Valor a integrar";
      $<HTMLTextAreaElement>("revValor").value = s.propuesto;
      $<HTMLTextAreaElement>("revRespuesta").value = "";
      mRev.abrir();
    }),
  );

  const revisar = async (accion: "aprobar" | "rechazar") => {
    if (!sugerencia || revisando) return;
    const s = sugerencia;
    const valor = $<HTMLTextAreaElement>("revValor").value.trim();
    const respuesta = $<HTMLTextAreaElement>("revRespuesta").value.trim();
    if (accion === "aprobar" && !valor && (s.campo === "otro" || s.campo === "diagnostico" || s.campo === "motivoConsulta")) {
      return errorEn("revError", "El valor a integrar no puede quedar vacío.");
    }

    const ok = await confirmar(
      accion === "aprobar"
        ? {
            titulo: "¿Integrar al expediente?",
            mensaje: s.campo === "otro"
              ? "Se agregará como nota de evolución en el expediente del paciente."
              : `«${s.etiqueta}» cambiará de "${s.actual || "sin registrar"}" a "${valor || "sin registrar"}".`,
            aceptar: "Confirmar e integrar",
          }
        : { titulo: "¿Rechazar sugerencia?", mensaje: "El expediente no cambiará y el paciente verá que no se integró.", aceptar: "Rechazar", peligro: true },
    );
    if (!ok) return;

    revisando = true;
    $<HTMLButtonElement>("aprobarRev").disabled = true;
    $<HTMLButtonElement>("rechazarRev").disabled = true;
    const r = await api(`/api/medico/solicitud/${s.id}`, "PUT", { accion, valor, respuesta });
    if (r.ok) {
      // Los botones siguen bloqueados hasta recargar para no revisar dos veces
      mRev.cerrar();
      await exito(
        accion === "aprobar" ? "Sugerencia integrada" : "Sugerencia rechazada",
        accion === "aprobar"
          ? "El cambio quedó guardado en el expediente y el paciente lo verá como integrado."
          : "El expediente no cambió y el paciente verá que la sugerencia no se integró.",
      );
    } else {
      revisando = false;
      $<HTMLButtonElement>("aprobarRev").disabled = false;
      $<HTMLButtonElement>("rechazarRev").disabled = false;
      errorEn("revError", r.data.error || "No se pudo guardar la revisión");
    }
  };
  $("formRev").addEventListener("submit", (e) => {
    e.preventDefault();
    revisar("aprobar");
  });
  $("rechazarRev").addEventListener("click", () => revisar("rechazar"));
</script>
