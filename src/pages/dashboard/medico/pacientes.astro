---
import DashboardLayout from "../../../components/common/DashboardLayout.astro";
import PageHeader from "../../../components/dashboard/PageHeader.astro";
import EmptyState from "../../../components/dashboard/EmptyState.astro";
import SearchInput from "../../../components/dashboard/SearchInput.astro";
import { card, btnPrimary, btnSecondary, label, plural } from "../../../components/dashboard/styles";
import { getSessionFromRequest } from "../../../lib/session";
import connectDB from "../../../lib/db";
import { User } from "../../../models/User";

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== "medico") return Astro.redirect("/login");

await connectDB();
const pacientes = await User.find({ role: "paciente", medicoAsignado: session.userId })
  .select("-password -resetPasswordToken -resetPasswordExpires")
  .sort({ createdAt: -1 });
---

<DashboardLayout title="Pacientes" role="medico" nombre={session.nombre} activeSection="/dashboard/medico/pacientes">

  <div class="max-w-6xl px-6 sm:px-10 py-10 lg:py-14 space-y-12">

    <PageHeader eyebrow="Gestión">
      <Fragment slot="title"><strong>Mis Pacientes</strong></Fragment>
      Acompañas a <strong>{plural(pacientes.length, "paciente", "pacientes")}</strong> en su recuperación.
      <button slot="action" id="asignarBtn" class={`${btnPrimary} shrink-0 self-start sm:self-auto`}>
        + Asignar paciente
      </button>
    </PageHeader>

    <SearchInput placeholder="Buscar paciente por nombre o correo..." />

    <hr class="border-stone-300" />

    {pacientes.length === 0 ? (
      <EmptyState title="Sin pacientes asignados aún" text="Asigna tu primer paciente para empezar a darle seguimiento.">
        <button id="asignarBtn2" class={`${btnPrimary} mt-6`}>Asignar primer paciente</button>
      </EmptyState>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pacientes.map((p: any) => (
          <article class={`${card} flex flex-col gap-6`}>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-black flex items-center justify-center text-white text-xl font-baloo font-bold shrink-0">
                {p.nombre.charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0">
                <p class="text-xl font-semibold text-gray-900 truncate">{p.nombre} {p.apellido}</p>
                <p class="text-base text-gray-600 truncate">{p.email}</p>
              </div>
            </div>

            <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-stone-200 pt-5">
              <div class="sm:col-span-2">
                <dt class={label}>Diagnóstico</dt>
                <dd class="text-lg font-medium text-gray-900 mt-1">{p.diagnostico || "—"}</dd>
              </div>
              <div>
                <dt class={label}>Teléfono</dt>
                <dd class="text-lg font-medium text-gray-900 mt-1">{p.telefono || "—"}</dd>
              </div>
            </dl>

            <div class="flex flex-wrap gap-3 mt-auto">
              <a href={`/dashboard/medico/expedientes?paciente=${p._id}`} class={btnSecondary}>Expediente</a>
              <a href={`/dashboard/medico/rutinas?paciente=${p._id}`} class={btnSecondary}>Rutinas</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>

  <!-- Modal asignar -->
  <div id="modalAsignar" class="hidden fixed inset-0 z-50 bg-black/30 dark:bg-[#000]/60 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg border border-gray-200 shadow-lg p-6 w-full max-w-sm">
      <h2 class="font-baloo tracking-wide text-2xl mb-1"><strong>Asignar paciente</strong></h2>
      <p class="text-base text-gray-600 mb-5">Busca por correo electrónico</p>
      <input id="emailBuscar" type="email" placeholder="correo@paciente.com"
        class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors mb-3" />
      <div id="resultadoBusqueda" class="hidden mb-3">
        <div class="p-3 border border-gray-200 rounded-lg text-base" id="pacienteInfo"></div>
      </div>
      <div id="errorBusqueda" class="hidden text-base text-red-600 mb-3"></div>
      <div class="flex gap-2">
        <button id="cancelarModal"
          class="flex-1 px-4 py-2 border border-gray-200 rounded-lg text-base font-medium hover:border-gray-400 transition-colors">
          Cancelar
        </button>
        <button id="buscarPacienteBtn"
          class="flex-1 px-4 py-2 border border-black bg-black text-white rounded-lg text-base font-medium hover:bg-white hover:text-black transition-colors">
          Buscar
        </button>
        <button id="confirmarAsignar"
          class="hidden flex-1 px-4 py-2 bg-black text-white rounded-lg text-base font-medium hover:bg-gray-800 transition-colors">
          Asignar
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  let pacienteEncontrado: any = null;
  const openModal = () => document.getElementById("modalAsignar")?.classList.remove("hidden");
  document.getElementById("asignarBtn")?.addEventListener("click", openModal);
  document.getElementById("asignarBtn2")?.addEventListener("click", openModal);
  document.getElementById("cancelarModal")?.addEventListener("click", () => {
    document.getElementById("modalAsignar")?.classList.add("hidden");
    pacienteEncontrado = null;
  });
  document.getElementById("buscarPacienteBtn")?.addEventListener("click", async () => {
    const email = (document.getElementById("emailBuscar") as HTMLInputElement)?.value;
    if (!email) return;
    const res = await fetch(`/api/medico/buscar-paciente?email=${encodeURIComponent(email)}`);
    const data = await res.json();
    const errorEl = document.getElementById("errorBusqueda")!;
    const resultadoEl = document.getElementById("resultadoBusqueda")!;
    const infoEl = document.getElementById("pacienteInfo")!;
    const confirmarBtn = document.getElementById("confirmarAsignar")!;
    if (!res.ok || !data) {
      errorEl.textContent = "No se encontró ningún paciente con ese correo.";
      errorEl.classList.remove("hidden");
      resultadoEl.classList.add("hidden");
      confirmarBtn.classList.add("hidden");
      return;
    }
    pacienteEncontrado = data;
    infoEl.textContent = `${data.nombre} ${data.apellido} — ${data.email}`;
    errorEl.classList.add("hidden");
    resultadoEl.classList.remove("hidden");
    confirmarBtn.classList.remove("hidden");
  });
  document.getElementById("confirmarAsignar")?.addEventListener("click", async () => {
    if (!pacienteEncontrado) return;
    const res = await fetch("/api/medico/pacientes", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ pacienteId: pacienteEncontrado._id }),
    });
    if (res.ok) window.location.reload();
  });
</script>
