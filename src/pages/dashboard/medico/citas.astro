---
import DashboardLayout from "../../../components/common/DashboardLayout.astro";
import PageHeader from "../../../components/dashboard/PageHeader.astro";
import EmptyState from "../../../components/dashboard/EmptyState.astro";
import SearchInput from "../../../components/dashboard/SearchInput.astro";
import { card, btnPrimary, btnSecondary, chip, hora, plural, diaRelativo } from "../../../components/dashboard/styles";
import { getSessionFromRequest } from "../../../lib/session";
import connectDB from "../../../lib/db";
import { Cita } from "../../../models/Cita";
import { User } from "../../../models/User";

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== "medico") return Astro.redirect("/login");

await connectDB();

const hoy = new Date();
hoy.setHours(0, 0, 0, 0);
const finSemana = new Date(hoy);
finSemana.setDate(finSemana.getDate() + 7);

const [citasProximas, pacientes] = await Promise.all([
  Cita.find({
    medico: session.userId,
    fecha: { $gte: hoy, $lte: finSemana },
    estado: { $ne: "cancelada" },
  })
    .populate("paciente", "nombre apellido")
    .sort({ fecha: 1 }),
  User.find({ role: "paciente", medicoAsignado: session.userId })
    .select("_id nombre apellido")
    .sort({ nombre: 1 }),
]);

const tipos = ["evaluacion", "tratamiento", "seguimiento", "alta"];

// Agrupa las citas por día (ya vienen ordenadas por fecha)
const porDia = new Map<string, any[]>();
for (const c of citasProximas as any[]) {
  const clave = new Date(c.fecha).toDateString();
  if (!porDia.has(clave)) porDia.set(clave, []);
  porDia.get(clave)!.push(c);
}
const dias = [...porDia.values()];

const confirmadas = citasProximas.filter((c: any) => c.estado === "confirmada").length;
const pendientes = citasProximas.filter((c: any) => c.estado === "pendiente").length;
---

<DashboardLayout
  title="Citas"
  role="medico"
  nombre={session.nombre}
  activeSection="/dashboard/medico/citas"
>
  <div class="max-w-6xl px-6 sm:px-10 py-10 lg:py-14 space-y-12">

    <PageHeader eyebrow="Agenda · próximos 7 días">
      <Fragment slot="title"><strong>Citas</strong></Fragment>
      Tienes <strong>{plural(citasProximas.length, "cita", "citas")}</strong> esta semana:
      <strong>{confirmadas}</strong> confirmadas y <strong>{pendientes}</strong> por confirmar.
      <button slot="action" id="nuevaCitaBtn" class={`${btnPrimary} shrink-0 self-start sm:self-auto`}>
        + Nueva cita
      </button>
    </PageHeader>

    <SearchInput placeholder="Buscar cita por paciente o tipo..." />

    {dias.length === 0 ? (
      <>
        <hr class="border-stone-300" />
        <EmptyState title="Sin citas esta semana" text="Agenda una nueva cita con el botón de arriba." />
      </>
    ) : (
      dias.map((citas) => {
        const fecha = new Date(citas[0].fecha);
        return (
          <>
            <hr class="border-stone-300" />
            <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10">
              <!-- Día -->
              <div class="lg:col-span-3">
                <p class="text-3xl font-baloo font-bold">{diaRelativo(fecha)}</p>
                <p class="text-base text-gray-600 mt-1">{plural(citas.length, "cita", "citas")}</p>
              </div>

              <!-- Citas del día -->
              <div class="lg:col-span-9 space-y-4">
                {citas.map((c: any) => {
                  const f = new Date(c.fecha);
                  return (
                    <article class={`${card} flex flex-col sm:flex-row sm:items-center gap-5`}>
                      <div class="sm:w-28 shrink-0">
                        <p class="text-3xl font-baloo font-bold leading-none">{hora(f)}</p>
                        <p class="text-base text-gray-600 mt-1">{c.duracion} min</p>
                      </div>
                      <div class="flex-1 min-w-0 sm:border-l sm:border-stone-200 sm:pl-5">
                        <p class="text-xl font-semibold text-gray-900 truncate">
                          {c.paciente.nombre} {c.paciente.apellido}
                        </p>
                        <p class="text-base text-gray-600 capitalize">{c.tipo}</p>
                      </div>
                      <div class="flex flex-wrap items-center gap-3">
                        <span class={chip(c.estado === "confirmada")}>{c.estado}</span>
                        {c.estado !== "confirmada" && (
                          <button data-id={c._id} data-action="confirmar" class={`confirm-btn ${btnSecondary}`}>
                            Confirmar
                          </button>
                        )}
                        <button data-id={c._id} data-action="cancelar" class={`cancel-btn ${btnSecondary}`}>
                          Cancelar
                        </button>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          </>
        );
      })
    )}
  </div>

  <!-- Modal nueva cita -->
  <div
    id="modalCita"
    class="hidden fixed inset-0 z-50 bg-black/30 dark:bg-[#000]/60 flex items-center justify-center p-4"
  >
    <div
      class="bg-white rounded-lg border border-gray-200 shadow-lg p-6 w-full max-w-md"
    >
      <h2 class="font-baloo tracking-wide text-2xl mb-1">
        <strong>Nueva cita</strong>
      </h2>
      <p class="text-base text-gray-600 mb-5">
        Completa los datos de la cita
      </p>
      <div class="space-y-3">
        <div>
          <label
            class="text-sm text-gray-600 font-medium block mb-1.5 uppercase tracking-wide"
            >Paciente</label
          >
          <select
            id="citaPaciente"
            class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors"
          >
            <option value="">Seleccionar paciente...</option>
            {
              pacientes.map((p: any) => (
                <option value={p._id}>
                  {p.nombre} {p.apellido}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label
            class="text-sm text-gray-600 font-medium block mb-1.5 uppercase tracking-wide"
            >Fecha y hora</label
          >
          <input
            id="citaFecha"
            type="datetime-local"
            class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors"
          />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label
              class="text-sm text-gray-600 font-medium block mb-1.5 uppercase tracking-wide"
              >Tipo</label
            >
            <select
              id="citaTipo"
              class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors"
            >
              {
                tipos.map((t) => (
                  <option value={t}>
                    {t.charAt(0).toUpperCase() + t.slice(1)}
                  </option>
                ))
              }
            </select>
          </div>
          <div>
            <label
              class="text-sm text-gray-600 font-medium block mb-1.5 uppercase tracking-wide"
              >Duración (min)</label
            >
            <input
              id="citaDuracion"
              type="number"
              value="60"
              min="15"
              max="180"
              step="15"
              class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors"
            />
          </div>
        </div>
        <div>
          <label
            class="text-sm text-gray-600 font-medium block mb-1.5 uppercase tracking-wide"
            >Notas</label
          >
          <textarea
            id="citaNotas"
            rows="2"
            class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-base focus:outline-none focus:border-black transition-colors resize-none"
          ></textarea>
        </div>
        <div id="citaError" class="hidden text-base text-red-600">
        </div>
        <div class="flex gap-2 pt-1">
          <button
            id="cancelarCita"
            class="flex-1 px-4 py-2.5 border border-gray-200 rounded-lg text-base font-medium hover:border-gray-400 transition-colors"
          >
            Cancelar
          </button>
          <button
            id="guardarCita"
            class="flex-1 px-4 py-2.5 bg-black text-white rounded-lg text-base font-medium hover:bg-gray-800 transition-colors"
          >
            Guardar cita
          </button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  document
    .getElementById("nuevaCitaBtn")
    ?.addEventListener("click", () =>
      document.getElementById("modalCita")?.classList.remove("hidden"),
    );
  document
    .getElementById("cancelarCita")
    ?.addEventListener("click", () =>
      document.getElementById("modalCita")?.classList.add("hidden"),
    );

  document
    .getElementById("guardarCita")
    ?.addEventListener("click", async () => {
      const paciente = (
        document.getElementById("citaPaciente") as HTMLSelectElement
      ).value;
      const fecha = (document.getElementById("citaFecha") as HTMLInputElement)
        .value;
      const tipo = (document.getElementById("citaTipo") as HTMLSelectElement)
        .value;
      const duracion = (
        document.getElementById("citaDuracion") as HTMLInputElement
      ).value;
      const notas = (
        document.getElementById("citaNotas") as HTMLTextAreaElement
      ).value;
      const errorEl = document.getElementById("citaError")!;
      if (!paciente || !fecha) {
        errorEl.textContent = "Selecciona un paciente y una fecha.";
        errorEl.classList.remove("hidden");
        return;
      }
      const res = await fetch("/api/medico/citas", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          paciente,
          fecha,
          tipo,
          duracion: Number(duracion),
          notas,
        }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const d = await res.json();
        errorEl.textContent = d.error || "Error al guardar";
        errorEl.classList.remove("hidden");
      }
    });

  document.querySelectorAll(".confirm-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.getAttribute("data-id");
      await fetch(`/api/medico/cita/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ estado: "confirmada" }),
      });
      window.location.reload();
    });
  });
  document.querySelectorAll(".cancel-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("¿Cancelar esta cita?")) return;
      await fetch(`/api/medico/cita/${btn.getAttribute("data-id")}`, {
        method: "DELETE",
      });
      window.location.reload();
    });
  });
</script>
