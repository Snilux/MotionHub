---
import DashboardLayout from "../../../components/common/DashboardLayout.astro";
import ProfileView from "../../../components/dashboard/ProfileView.astro";
import SettingsRow from "../../../components/dashboard/SettingsRow.astro";
import { card, btnPrimary, input, label } from "../../../components/dashboard/styles";
import { getSessionFromRequest } from "../../../lib/session";
import connectDB from "../../../lib/db";
import { User } from "../../../models/User";

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== "medico") return Astro.redirect("/login");

await connectDB();
const medico: any = await User.findById(session.userId).select(
  "nombre apellido email telefono fechaNacimiento cedulaProfesional especialidad estadoVerificacion createdAt googleId password pendingEmail pendingEmailExpires fotoPerfil",
);
if (!medico) return Astro.redirect("/login");

const datosProfesionales = [
  { id: "perfilEspecialidad", name: "especialidad",      label: "Especialidad",       value: medico.especialidad ?? "",      placeholder: "Ej: Fisioterapia deportiva" },
  { id: "perfilCedula",       name: "cedulaProfesional", label: "Cédula profesional", value: medico.cedulaProfesional ?? "", placeholder: "Ej: 12345678", inputmode: "numeric", maxlength: 8 },
];

const ESTADOS: Record<string, string> = { aprobada: "Verificada", rechazada: "No aprobada", pendiente: "En revisión" };
const estado = ESTADOS[medico.estadoVerificacion ?? "pendiente"];
const aprobada = medico.estadoVerificacion === "aprobada";
---

<DashboardLayout title="Mi perfil" role="medico" nombre={session.nombre} activeSection="/dashboard/medico/perfil">
  <ProfileView
    usuario={medico}
    prefijo="Dr. "
    subtitulo={medico.especialidad || "Fisioterapeuta"}
    identidad={[{ label: "Cédula", value: medico.cedulaProfesional || "—" }, { label: "Cuenta", value: estado }]}
    fotoDesc="Tus pacientes la verán junto a tus citas y rutinas."
  >
    <SettingsRow title="Información profesional" desc="Datos que acreditan tu práctica como fisioterapeuta.">
      <form data-perfil class={`${card} space-y-6`} novalidate>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {datosProfesionales.map((campo) => (
            <div>
              <label for={campo.id} class={`${label} block mb-2`}>{campo.label}</label>
              <input id={campo.id} name={campo.name} type="text" value={campo.value} placeholder={campo.placeholder}
                inputmode={campo.inputmode} maxlength={campo.maxlength} class={input} />
            </div>
          ))}
        </div>
        <p class="text-sm text-gray-500">
          {aprobada
            ? "Tu cédula está verificada. Si la cambias, tu cuenta volverá a revisión y no podrás atender pacientes hasta que la verifiquemos de nuevo."
            : "Un administrador verificará tu cédula. Al guardar cambios, tu cuenta queda en revisión."}
        </p>
        <p data-error class="hidden text-base text-red-600"></p>
        <div class="flex justify-end border-t border-stone-200 pt-6">
          <button type="submit" class={btnPrimary}>Guardar cambios</button>
        </div>
      </form>
    </SettingsRow>
  </ProfileView>
</DashboardLayout>
