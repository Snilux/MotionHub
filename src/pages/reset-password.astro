---
import Title from "../components/common/Title.astro";
import Layout from "../layouts/Layout.astro";
import AnimationBgAuth from "../components/common/AnimationBgAuth.astro";
import BackButton from "../components/common/buttons/BackButton.astro";
import ThemeToggle from "../components/common/ThemeToggle.astro";
---

<Layout title="Restablecer Contraseña">
  <ThemeToggle class="fixed top-4 right-4 z-20 bg-white/60 backdrop-blur-xl shadow-md" />
    <div
        class="relative isolate min-h-screen flex items-center justify-center p-4 overflow-hidden"
    >
        <!-- Background Animation -->
        <div class="absolute inset-0 -z-10">
            <AnimationBgAuth />
        </div>

        <!-- Content -->
        <div class="w-full max-w-md relative z-10">
            <!-- Logo -->
            <div class="text-center mb-4">
                <div class="flex items-center justify-center gap-2 mb-2">
                    <a href="/" transition:name="brand-logo">
                        <Title size="lg" />
                    </a>
                </div>
            </div>

            <!-- Glass Card -->
            <div
                transition:name="auth-card"
                class="backdrop-blur-xl bg-white/50 rounded-3xl shadow-2xl p-8"
            >
                <BackButton />
                <div class="mb-8">
                    <h2 class="text-3xl font-medium mb-2">
                        Restablecer contraseña
                    </h2>
                    <p class="font-light opacity-80">
                        Ingresa tu correo electrónico y te enviaremos un enlace
                        para restablecer tu contraseña
                    </p>
                </div>

                <form id="resetForm" class="space-y-6">
                    <!-- Email Input -->
                    <div>
                        <label
                            for="email"
                            class="block text-sm font-medium text-gray-700 mb-2"
                        >
                            Correo electrónico
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder="tu@email.com"
                            class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 placeholder:text-gray-400"
                        />
                    </div>

                    <div id="resetError" class="hidden text-sm text-red-600 bg-red-50 px-3 py-2 rounded-xl"></div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="w-full bg-linear-to-r from-blue-600 to-blue-500 text-white keep-light py-3 px-4 rounded-xl font-semibold hover:from-blue-700 hover:to-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 shadow-lg shadow-blue-500/30"
                    >
                        Enviar enlace de restablecimiento
                    </button>

                    <!-- Back to Login Link -->
                    <div class="text-center">
                        <a
                            href="/login"
                            class="text-sm text-blue-600 dark:text-blue-300 hover:text-blue-700 dark:hover:text-blue-200 font-medium inline-flex items-center gap-2"
                        >
                            Volver al inicio de sesión
                        </a>
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="mt-6 text-center text-sm text-gray-500">
                <p>© 2024 MotionHub. Todos los derechos reservados.</p>
            </div>
        </div>
    </div>
</Layout>

<script>
  const form = document.getElementById("resetForm") as HTMLFormElement | null;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const errorEl = document.getElementById("resetError")!;
    if (btn.disabled) return;
    errorEl.classList.add("hidden");
    btn.disabled = true;
    btn.textContent = "Enviando...";

    const res = await fetch("/api/auth/forgot-password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email }),
    }).catch(() => null);
    const data = res ? await res.json().catch(() => ({})) : { error: "Sin conexión con el servidor" };

    if (!res?.ok) {
      // Correo inválido, demasiados intentos (429) o error del servidor
      errorEl.textContent = data.error || "No se pudo enviar el enlace. Inténtalo de nuevo.";
      errorEl.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Enviar enlace de restablecimiento";
      return;
    }

    // Reemplaza el formulario por el mensaje de éxito (textContent: sin HTML inyectado)
    form.innerHTML = `<div class="text-center py-4">
      <div class="text-4xl mb-3">📧</div>
      <p class="font-medium text-gray-900 mb-2">Revisa tu correo</p>
      <p data-msg class="text-sm text-gray-500"></p>
      <p class="text-xs text-gray-400 mt-3">¿No llega? Revisa la carpeta de spam o vuelve a intentarlo en unos minutos.</p>
      <a href="/login" class="inline-block mt-4 text-sm text-blue-600 dark:text-blue-300 hover:text-blue-700 dark:hover:text-blue-200 font-medium">← Volver al inicio de sesión</a>
    </div>`;
    form.querySelector("[data-msg]")!.textContent = data.message;
  });
</script>
