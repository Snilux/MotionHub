---
// Paso final del registro con Google: el usuario elige si es fisioterapeuta o paciente.
import Title from "../components/common/Title.astro";
import Layout from "../layouts/Layout.astro";
import AnimationBgAuth from "../components/common/AnimationBgAuth.astro";
import ThemeToggle from "../components/common/ThemeToggle.astro";
import { getCookie, verifyShortToken } from "../lib/session";
import { GOOGLE_SIGNUP_COOKIE, type GoogleProfile } from "../lib/google";

const perfil = verifyShortToken<GoogleProfile>(getCookie(Astro.request, GOOGLE_SIGNUP_COOKIE));
if (!perfil) return Astro.redirect("/login?razon=google_error");

const inputCls =
  "w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 placeholder:text-gray-400";
const labelCls = "block text-sm font-medium text-gray-700 mb-2";
---

<Layout title="Completar registro">
  <ThemeToggle class="fixed top-4 right-4 z-20 bg-white/60 backdrop-blur-xl shadow-md" />
  <div class="relative isolate min-h-screen flex items-center justify-center p-4 overflow-hidden">
    <div class="absolute inset-0 -z-10"><AnimationBgAuth /></div>

    <div class="w-full max-w-md relative z-10">
      <div class="text-center mb-4">
        <a href="/" transition:name="brand-logo"><Title size="lg" /></a>
      </div>

      <div transition:name="auth-card" class="backdrop-blur-xl bg-white/50 rounded-3xl shadow-2xl p-8">
        <div class="mb-6">
          <h2 class="text-3xl font-medium mb-2">Un último paso</h2>
          <p class="font-light opacity-80">
            Entraste con <strong class="font-medium">{perfil.email}</strong>. Dinos cómo usarás MotionHub.
          </p>
        </div>

        <form id="completarForm" class="space-y-5">
          <fieldset>
            <legend class={labelCls}>Tipo de cuenta</legend>
            <div class="grid grid-cols-2 gap-3">
              <label class="cursor-pointer">
                <input type="radio" name="role" value="paciente" class="peer sr-only" checked />
                <span class="block text-center px-4 py-3 border border-gray-200 rounded-xl bg-white/50 peer-checked:border-black peer-checked:bg-black peer-checked:text-white transition-colors">
                  Paciente
                </span>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="role" value="medico" class="peer sr-only" />
                <span class="block text-center px-4 py-3 border border-gray-200 rounded-xl bg-white/50 peer-checked:border-black peer-checked:bg-black peer-checked:text-white transition-colors">
                  Fisioterapeuta
                </span>
              </label>
            </div>
          </fieldset>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="nombre" class={labelCls}>Nombre</label>
              <input id="nombre" required value={perfil.nombre} class={inputCls} />
            </div>
            <div>
              <label for="apellido" class={labelCls}>Apellido</label>
              <input id="apellido" required value={perfil.apellido} class={inputCls} />
            </div>
          </div>

          <div>
            <label for="telefono" class={labelCls}>Teléfono (opcional)</label>
            <input id="telefono" type="tel" placeholder="+52 000 000 0000" class={inputCls} />
          </div>

          <div id="camposMedico" class="hidden space-y-5">
            <p class="text-xs text-gray-500">
              Verificaremos tu cédula antes de activar tu cuenta. Mientras tanto podrás entrar, pero no atender pacientes.
            </p>
            <div>
              <label for="cedula" class={labelCls}>Cédula profesional</label>
              <input id="cedula" inputmode="numeric" maxlength="8" placeholder="Ej: 12345678" class={inputCls} />
            </div>
            <div>
              <label for="especialidad" class={labelCls}>Especialidad</label>
              <input id="especialidad" maxlength="100" placeholder="Ej: Fisioterapia deportiva" class={inputCls} />
            </div>
          </div>

          <div id="completarError" class="hidden text-sm text-red-600 bg-red-50 px-3 py-2 rounded-xl"></div>

          <button
            type="submit"
            id="completarBtn"
            class="w-full bg-linear-to-r from-blue-600 to-blue-500 text-white keep-light py-3 px-4 rounded-xl font-semibold hover:from-blue-700 hover:to-blue-600 transition-all duration-200 shadow-lg shadow-blue-500/30 disabled:opacity-60"
          >
            Crear mi cuenta
          </button>
          <a href="/login" class="block text-center text-sm text-gray-600 hover:underline">Cancelar</a>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { CEDULA_RE } from "../lib/verificacion";

  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
  const camposMedico = document.getElementById("camposMedico")!;

  document.querySelectorAll<HTMLInputElement>('input[name="role"]').forEach((r) =>
    r.addEventListener("change", () => camposMedico.classList.toggle("hidden", r.value !== "medico" || !r.checked)),
  );

  document.getElementById("completarForm")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = document.getElementById("completarBtn") as HTMLButtonElement;
    const errorEl = document.getElementById("completarError")!;
    const role = (document.querySelector('input[name="role"]:checked') as HTMLInputElement).value;

    const mostrarError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.classList.remove("hidden");
    };
    errorEl.classList.add("hidden");
    // Misma regla que el servidor (src/lib/verificacion.ts)
    if (role === "medico") {
      if (!CEDULA_RE.test(val("cedula").replace(/[\s-]/g, ""))) return mostrarError("La cédula profesional debe tener 7 u 8 dígitos");
      if (val("especialidad").length < 3) return mostrarError("Indica tu especialidad");
    }
    btn.disabled = true;

    const res = await fetch("/api/auth/google/completar", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        role,
        nombre: val("nombre"),
        apellido: val("apellido"),
        telefono: val("telefono"),
        cedulaProfesional: val("cedula").replace(/[\s-]/g, ""),
        especialidad: val("especialidad"),
      }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      window.location.href = data.redirect;
    } else {
      mostrarError(data.error || "No se pudo crear la cuenta");
      btn.disabled = false;
    }
  });
</script>
